### Add Todo 1
POST http://localhost:8080/api/todos
Content-Type: application/json

{
  "name": "Pick up food",
  "description": "Milk, Eggs",
  "completed": false
}

> {%
    client.global.set("todo1Id", response.body.id);
    client.test('http status is correct', () => {
        client.assert(response.status === 200, "wrong status");
        client.assert(response.body.name === "Pick up food", "wrong name");
    });
%}

### Adding another todo
POST http://localhost:8080/api/todos
Content-Type: application/json

{
  "name": "File taxes",
  "description": "Before Apr 15",
  "completed": false
}

> {%
    client.global.set("todo2Id", response.body.id);
    client.test('http status is correct', () => {
        client.assert(response.status === 200, "wrong status");
        client.assert(response.body.name === "File taxes", "wrong name");
    });
%}
