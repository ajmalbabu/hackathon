%}

### Delete todo 4
DELETE http://localhost:8080/api/todos/{{todo4Id}}

> {%
    client.test('http status is correct', () => {
        client.assert(response.status === 200, "wrong status");
    });
%}

### Update todo 1
PUT http://localhost:8080/api/todos/{{todo1Id}}
Content-Type: application/json

{
  "name": "Pick up food",
  "description": "Milk, Eggs",
  "completed": true,
  "dateCreated": "2024-12-01"
}

> {%
    client.test('http status is correct', () => {
        client.assert(response.status === 200, "wrong status");
        client.assert(response.body.dateCreated === "2024-12-01", "wrong date");
    });
%}

### Get Todo 1
GET http://localhost:8080/api/todos/{{todo1Id}}

### Text search
POST http://localhost:8080/api/todos/search
Content-Type: application/json

"Milk"

> {%
    client.test('http status is correct', () => {
        client.assert(response.status === 200, "wrong status");
    });
    client.test("Response is an array with 2 elements", () => {
        return Array.isArray(response.body) && response.body.length === 2;
     // TODO FIXME this is a bug in TodoService.update: it does not remove the old todo hence the 2 todos
    });
%}